// Note to translators:
// If a sentence is the same in your language then please change it to "#same"
//
// eg:
// LANG_ENGLISH  "HALT"
// LANG_GERMAN   "#same"
//
// (This is so we can tell which strings have been signed-off as ok to be the same words for QA
//  and because we do not store duplicate strings, which will then get exported again next time
//  as being untranslated.)
//
VERSION             "1"
CONFIG              "F:\projects\mk-work\bin\StringEd\StringEd.cfg"
FILENOTES           ""

REFERENCE           OBJECTIVE_HQ
LANG_ENGLISH        "Report the town's capture to Regimental HQ."
LANG_SPANISH        "Informar de la captura de la ciudad al Cuartel General del regimiento."

REFERENCE           OBJECTIVE_NEWCAR
LANG_ENGLISH        "Find another vehicle."
LANG_SPANISH        "Encontrar otro vehículo"

REFERENCE           OBJECTIVE_DEFEND_ELDER
LANG_ENGLISH        "Defend Private Elder."
LANG_SPANISH        "Defender al soldado Elder"

REFERENCE           HINT_GETINCAR
LANG_ENGLISH        "Press USE [%s] to get in the car."
LANG_SPANISH        "Pulsa USAR [%s] para entrar en el coche"

REFERENCE           FAILED_COVER_ELDER
LANG_ENGLISH        "You failed to cover Private Elder."
LANG_SPANISH        "Has fallado al cubrir al soldado Elder."

REFERENCE           OBJECTIVE_GETINCAR
LANG_ENGLISH        "Get in the Kubelwagen."
LANG_SPANISH        "Entrar en el Kubelwagen"


ENDMARKER



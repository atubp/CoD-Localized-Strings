// Note to translators:
// If a sentence is the same in your language then please change it to "#same"
//
// eg:
// LANG_ENGLISH  "HALT"
// LANG_GERMAN   "#same"
//
// (This is so we can tell which strings have been signed-off as ok to be the same words for QA
//  and because we do not store duplicate strings, which will then get exported again next time
//  as being untranslated.)
//
VERSION             "1"
CONFIG              "F:\projects\mk-work\bin\StringEd\StringEd.cfg"
FILENOTES           ""

REFERENCE           KILLED_ALLIED_SOLDIER
LANG_ENGLISH        "%s ^7killed an Allied soldier"
LANG_SPANISH        "%s ^7mató a un soldado Aliado"

REFERENCE           MOVED_TO_AXIS
LANG_ENGLISH        "%s ^7was moved to the Axis"
LANG_SPANISH        "%s ^7se ha cambiado al Eje"

REFERENCE           WONTBE_ALLIED
LANG_ENGLISH        "Too many Allies, you will stay on Axis"
LANG_SPANISH        "Demasiados Aliados, permanecerás con el Eje"

REFERENCE           REMOVING_ALLIED
LANG_ENGLISH        "Removing an Allied player from the game"
LANG_SPANISH        "Quitando a un soldado Aliado del juego"

REFERENCE           ADDING_ALLIED
LANG_ENGLISH        "Adding another Allied player to the game"
LANG_SPANISH        "Se ha añadido otro jugador Aliado a la partida"

REFERENCE           IS_NOW_ALLIED
LANG_ENGLISH        "%s ^7is now an Allied player"
LANG_SPANISH        "%s ^7es ahora un jugador Aliado"

REFERENCE           OBJ_ALLIED
LANG_ENGLISH        "Take out as many Axis soldiers as possible before being overrun."
LANG_SPANISH        "Eliminar a todos los soldados del Eje posibles antes de ser arrollados."

REFERENCE           OBJ_AXIS
LANG_ENGLISH        "Hunt down Allied soldiers. Search near the Question Marks."
LANG_SPANISH        "Acabar con los soldados Aliados. Buscar cerca de los signos de interrogación."

REFERENCE           BEHIND_ENEMY_LINES
LANG_ENGLISH        "Behind Enemy Lines"
LANG_SPANISH        "Tras las líneas enemigas"

REFERENCE           TIME_ALIVE
LANG_ENGLISH        "Time Alive: %s"
LANG_SPANISH        "Tiempo vivo: %s"

REFERENCE           POINTS_EARNED
LANG_ENGLISH        "Points Earned: %s"
LANG_SPANISH        "Puntos obtenidos: %s"

REFERENCE           SPECTATOR_OBJS
LANG_ENGLISH        "Allies: Take out as many Axis soldiers as possible before being overrun.\nAxis: Hunt down Allied soldiers. Search near the Question Marks."
LANG_SPANISH        "Aliados: eliminar a todos los soldados del Eje posibles antes de ser arrollados.\nEje: Acabar con los soldados Aliados. Buscar cerca de los signos de interrogación."

REFERENCE           TIME_TILL_SPAWN
LANG_ENGLISH        "Time until next respawn:"
LANG_SPANISH        "Tiempo hasta el siguiente reinicio:"

REFERENCE           BLACKSCREEN_KILLEDALLIED
LANG_ENGLISH        "You killed an Allied player!"
LANG_SPANISH        "¡Has matado a un soldado Aliado"

REFERENCE           BLACKSCREEN_WILLSPAWN
LANG_ENGLISH        "You will spawn as an Allied player"
LANG_SPANISH        "Volverás a aparecer como un soldado Aliado"


ENDMARKER



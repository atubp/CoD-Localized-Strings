// Note to translators:
// If a sentence is the same in your language then please change it to "#same"
//
// eg:
// LANG_ENGLISH  "HALT"
// LANG_GERMAN   "#same"
//
// (This is so we can tell which strings have been signed-off as ok to be the same words for QA
//  and because we do not store duplicate strings, which will then get exported again next time
//  as being untranslated.)
//
VERSION             "1"
CONFIG              "C:\trees\cod2\bin\StringEd.cfg"
FILENOTES           ""

REFERENCE           DEFEND_THE_SOUTH_SIDE
LANG_ENGLISH        "Defend the South side of town."
LANG_SPANISH         "Defiende la zona sur del pueblo."

REFERENCE           DEFEND_THE_WEST_SIDE
LANG_ENGLISH        "Defend the West side of town."
LANG_SPANISH         "Defiende la zona oeste del pueblo."

REFERENCE           DEFEND_THE_SOUTH_WEST
LANG_ENGLISH        "Defend the South West side of town."
LANG_SPANISH         "Defiende la zona suroeste del pueblo."

REFERENCE           DEFEND_THE_NORTH_SIDE
LANG_ENGLISH        "Defend the North side of town."
LANG_SPANISH         "Defiende la zona norte del pueblo."

REFERENCE           DEFEND_THE_SOUTH_SIDE1
LANG_ENGLISH        "Defend the South side of town using artillery. [&&1 remaining]"
LANG_SPANISH         "Defiende la zona sur del pueblo usando artillería. [&&1 restantes]"

REFERENCE           DEFEND_THE_NORTH_SIDE1
LANG_ENGLISH        "Defend the North side of town using artillery. [&&1 remaining]"
LANG_SPANISH         "Defiende la zona norte del pueblo usando artillería. [&&1 restantes]"

REFERENCE           DEFEND_THE_WEST_SIDE1
LANG_ENGLISH        "Defend the West side of town using artillery. [&&1 remaining]"
LANG_SPANISH         "Defiende la zona oeste del pueblo usando artillería. [&&1 restantes]"

REFERENCE           DEFEND_THE_SOUTH_WEST1
LANG_ENGLISH        "Defend the South West side of town using artillery. [&&1 remaining]"
LANG_SPANISH         "Defiende la zona suroeste del pueblo usando artillería. [&&1 restantes]"

REFERENCE           GET_A_BETTER_VANTAGE
LANG_ENGLISH        "Get a better vantage point on the roof."
LANG_SPANISH         "Busca una posición estratégica mejor en el tejado."

REFERENCE           TANKS_CAN_NOT_BE_HURT
LANG_ENGLISH        "Tanks can not be hurt by bullets or grenades."
LANG_SPANISH         "No se pueden dañar los tanques con munición convencional o granadas."

REFERENCE           FAILED_TO_DEFEND_THE
LANG_ENGLISH        "The German forces broke through to the center of the town. Mission Failed."
LANG_SPANISH         "Las fuerzas alemanas han logrado llegar al centro de la ciudad. Misión fallida."

REFERENCE           DEFEND_THE_SOUTH_SIDE1DONE
LANG_ENGLISH        "Defend the South side of town using artillery."
LANG_SPANISH         "Defiende el lado sur del pueblo mediante artillería."

REFERENCE           DEFEND_THE_NORTH_SIDE1DONE
LANG_ENGLISH        "Defend the North side of town using artillery."
LANG_SPANISH         "Defiende el lado norte del pueblo mediante artillería."

REFERENCE           DEFEND_THE_SOUTH_WEST1DONE
LANG_ENGLISH        "Defend the South West side of town using artillery."
LANG_SPANISH         "Defiende el lado suroeste del pueblo mediante artillería."


ENDMARKER



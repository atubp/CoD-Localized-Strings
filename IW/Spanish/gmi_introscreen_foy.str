// Note to translators:
// If a sentence is the same in your language then please change it to "#same"
//
// eg:
// LANG_ENGLISH  "HALT"
// LANG_GERMAN   "#same"
//
// (This is so we can tell which strings have been signed-off as ok to be the same words for QA
//  and because we do not store duplicate strings, which will then get exported again next time
//  as being untranslated.)
//
VERSION             "1"
CONFIG              "C:\cod\source_data\string_resources\StringEd.cfg"
FILENOTES           ""

REFERENCE           NEWREF
LANG_ENGLISH        "GMI_INTROSCREEN_FOY"
LANG_SPANISH        "#same"

REFERENCE           PLACE
LANG_ENGLISH        "Battle Of Bulge - Foy - Belgium"
LANG_SPANISH        "Batalla de las Ardenas - Foy - Bélgica"

REFERENCE           DATE
LANG_ENGLISH        "January 13, 1945"
LANG_SPANISH        "13 de enero de 1945"

REFERENCE           TIME
LANG_ENGLISH        "1100 hrs"
LANG_SPANISH        "11:00 h"


ENDMARKER



// Note to translators:
// If a sentence is the same in your language then please change it to "#same"
//
// eg:
// LANG_ENGLISH  "HALT"
// LANG_GERMAN   "#same"
//
// (This is so we can tell which strings have been signed-off as ok to be the same words for QA
//  and because we do not store duplicate strings, which will then get exported again next time
//  as being untranslated.)
//
VERSION             "1"
CONFIG              "F:\projects\mk-work\bin\StringEd\StringEd.cfg"
FILENOTES           ""

REFERENCE           FIVESIGNS
LANG_ENGLISH        "Use your mouse to look at the five large signs."
LANG_SPANISH        "Usa tu ratón para mirar las cinco señales grandes."

REFERENCE           OPENGATE
LANG_ENGLISH        "Open the gate and complete the obstacle course."
LANG_SPANISH        "Abre la puerta y completa el circuito de obstáculos."

REFERENCE           CLIMBLADDER
LANG_ENGLISH        "To climb a ladder, move forward into the ladder and look up."
LANG_SPANISH        "Para subir por una escalera, avanza hacia ella y mira hacia arriba."

REFERENCE           TARGETSIX
LANG_ENGLISH        "Hit the target 6 times."
LANG_SPANISH        "Acierta al objetivo 6 veces."

REFERENCE           FARTARGET
LANG_ENGLISH        "Hit the far target twice."
LANG_SPANISH        "Acierta al objetivo lejano dos veces."

REFERENCE           FARTARGETWICEAGAIN
LANG_ENGLISH        "Hit the far target twice again."
LANG_SPANISH        "Acierta al objetivo lejano dos veces más."

REFERENCE           TARGETTEN
LANG_ENGLISH        "Hit the target 10 times."
LANG_SPANISH        "Acierta al objetivo 10 veces."

REFERENCE           TARGETTHREE
LANG_ENGLISH        "Hit the target 3 times."
LANG_SPANISH        "Acierta al objetivo 3 veces."

REFERENCE           GRENADEDOORWINDOW
LANG_ENGLISH        "Throw a grenade through the door and each window."
LANG_SPANISH        "Arroja una granada por la puerta y por cada ventana."

REFERENCE           LASTGATE
LANG_ENGLISH        "Go through the last gate to exit training."
LANG_SPANISH        "Atraviesa la última puerta para salir del entrenamiento."

REFERENCE           BACKTRACK
LANG_ENGLISH        "Or backtrack through the weapons course if you want more practice."
LANG_SPANISH        "O retrocede por el circuito de armas si quieres seguir practicando."

REFERENCE           EXPLOSIVESPLANTED
LANG_ENGLISH        "Explosive planted."
LANG_SPANISH        "Explosivo colocado."

REFERENCE           OBJ1
LANG_ENGLISH        "Read each sign. [%s remaining]."
LANG_SPANISH        "Lee cada señal. [%s restantes]."

REFERENCE           OBJ2
LANG_ENGLISH        "Approach the sign indicated by the compass star."
LANG_SPANISH        "Acércate a la señal indicada por la flecha de la brújula."

REFERENCE           OBJ3
LANG_ENGLISH        "Open the gate to the obstacle course."
LANG_SPANISH        "Abre la puerta al circuito de obstáculos."

REFERENCE           OBJ4
LANG_ENGLISH        "Complete the obstacle course."
LANG_SPANISH        "Completa el circuito de obstáculos."

REFERENCE           OBJ5
LANG_ENGLISH        "Pick up both Carbines, hit the target a total of 12 times."
LANG_SPANISH        "Coge las dos carabinas, y acierta al objetivo un total de 12 veces."

REFERENCE           OBJ6
LANG_ENGLISH        "Pick up a Springfield, hit the target a total of 4 times."
LANG_SPANISH        "Coge un Springfield, y acierta al objetivo un total de 4 veces."

REFERENCE           OBJ7
LANG_ENGLISH        "Pick up a Thompson, hit the target 10 times."
LANG_SPANISH        "Coge una Thompson, y acierta al objetivo un total de 13 veces."

REFERENCE           OBJ8
LANG_ENGLISH        "Pick up some Grenades, throw a Grenade into each window and door."
LANG_SPANISH        "Coge algunas granadas, y arroja una granada por cada puerta y cada ventana."

REFERENCE           OBJ9
LANG_ENGLISH        "Plant the explosives."
LANG_SPANISH        "Coloca los explosivos."

REFERENCE           OBJ10
LANG_ENGLISH        "Go through the last gate to exit training."
LANG_SPANISH        "Atraviesa la última puertas para salir del entrenamiento."

REFERENCE           TRAINING_TEMP
LANG_ENGLISH        "TEMP note done yet."
LANG_SPANISH        "TIEMPO consumido."

REFERENCE           STAR_ABOVE
LANG_ENGLISH        "An arrow above or below the compass star means your objective is above or below you."
LANG_SPANISH        "Una flecha por encima o por debajo de la flecha de la brújula indica que tu objetivo está encima o debajo de ti."

REFERENCE           SHOT_MOODY
LANG_ENGLISH        "You fired a weapon at your instructor!"
LANG_SPANISH        "¡Has disparado un arma contra tu instructor!"

REFERENCE           NO_EXPLOSIVES
LANG_ENGLISH        "You don't have any explosives yet."
LANG_SPANISH        "Todavía no tienes explosivos."

REFERENCE           WAIT_INSTRUCTIONS
LANG_ENGLISH        "Do not place your explosives until instructed to. "
LANG_SPANISH        "No coloques los explosivos hasta que se te ordene."

REFERENCE           OBJ7B
LANG_ENGLISH        "Switch weapons, hit the target 3 more times."
LANG_SPANISH        "Cambie de armas, dispare al objetivo 3 veces más."

REFERENCE           PICKUP_CARBINE
LANG_ENGLISH        "Pick up the second M1A1 Carbine. "
LANG_SPANISH        "Coja la segunda carabina M1A1. "


ENDMARKER



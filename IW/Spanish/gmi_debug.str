// Note to translators:
// If a sentence is the same in your language then please change it to "#same"
//
// eg:
// LANG_ENGLISH  "HALT"
// LANG_GERMAN   "#same"
//
// (This is so we can tell which strings have been signed-off as ok to be the same words for QA
//  and because we do not store duplicate strings, which will then get exported again next time
//  as being untranslated.)
//
VERSION             "1"
CONFIG              "C:\cod\source_data\string_resources\StringEd.cfg"
FILENOTES           ""

REFERENCE           AI_COUNTER
LANG_ENGLISH        "AI:"
LANG_SPANISH        "IA:"

REFERENCE           VEHICLE_COUNTER
LANG_ENGLISH        "Vehicles:"
LANG_SPANISH        "Vehículos:"

REFERENCE           DUMMIES
LANG_ENGLISH        "Dummies:"
LANG_SPANISH        "Maniquíes:"

REFERENCE           BRUSHMODEL_ROTATE_PITCH
LANG_ENGLISH        "Pitch:"
LANG_SPANISH        "Cabeceo:"

REFERENCE           BRUSHMODEL_ROTATE_YAW
LANG_ENGLISH        "Yaw:"
LANG_SPANISH        "Guiñada:"

REFERENCE           BRUSHMODEL_ROTATE_ROLL
LANG_ENGLISH        "Roll:"
LANG_SPANISH        "Giro:"

REFERENCE           BRUSHMODEL_MOVE_X
LANG_ENGLISH        "X:"
LANG_SPANISH        "#same"

REFERENCE           BRUSHMODEL_MOVE_Y
LANG_ENGLISH        "Y:"
LANG_SPANISH        "#same"

REFERENCE           BRUSHMODEL_MOVE_Z
LANG_ENGLISH        "Z:"
LANG_SPANISH        "#same"

REFERENCE           AXIS_COUNTER
LANG_ENGLISH        "Axis:"
LANG_SPANISH        "Eje:"

REFERENCE           ALLIES_COUNTER
LANG_ENGLISH        "Allies:"
LANG_SPANISH        "Aliados:"


ENDMARKER



// Note to translators:
// If a sentence is the same in your language then please change it to "#same"
//
// eg:
// LANG_ENGLISH  "HALT"
// LANG_GERMAN   "#same"
//
// (This is so we can tell which strings have been signed-off as ok to be the same words for QA
//  and because we do not store duplicate strings, which will then get exported again next time
//  as being untranslated.)
//
VERSION             "1"
CONFIG              "C:\cod\source_data\string_resources\StringEd.cfg"
FILENOTES           ""

REFERENCE           GET_TO_THE_SHORE
LANG_ENGLISH        "Get to the shore."
LANG_SPANISH        "Llega a la orilla"

REFERENCE           FOLLOW_INGRAM_TO_SAFETY
LANG_ENGLISH        "Follow Ingram."
LANG_SPANISH        "Sigue a Ingram a un lugar seguro"

REFERENCE           CLEAR_THE_BLOCKADE
LANG_ENGLISH        "Clear the blockade."
LANG_SPANISH        "Despejar el bloqueo."

REFERENCE           DESTROY_ALL_ENEMY_BOATS
LANG_ENGLISH        "Destroy all German PT Boats (%s remaining)."
LANG_SPANISH        "Destruye todos los barcos enemigos (faltan %s)"

REFERENCE           GET_ON_THE_ESCAPE_BOAT
LANG_ENGLISH        "Board the captured German PT boat."
LANG_SPANISH        "Entra en la lancha de escape"

REFERENCE           GUN_OVERHEATED
LANG_ENGLISH        "Gun overheated"
LANG_SPANISH        "Arma sobrecalentada"

REFERENCE           PRESS_S_TO_GRAB_BIKE
LANG_ENGLISH        "press [%s] to grab bike mounted health kits (2 remaining)"
LANG_SPANISH        "Pulsa [%s] para coger los botiquines cuando vayas subido en la bicicleta (quedan 2)."

REFERENCE           PRESS_S_TO_GRAB_BIKE1
LANG_ENGLISH        "press [%s] to grab bike mounted health kits (1 remaining)"
LANG_SPANISH        "Pulsa [%s] para coger los botiquines cuando vayas subido en la bicicleta (queda 1)."

REFERENCE           WHILE_RIDING_THE_BMW
LANG_ENGLISH        "While riding the BMW bike use your stance keys to sit up and sit down."
LANG_SPANISH        "Mientras estás en la moto BMW puedes usar las teclas para levantarte o sentarte."

REFERENCE           PRESS_USE_
LANG_ENGLISH        "Press USE ["
LANG_SPANISH        "Pulsa USAR ["

REFERENCE           _TO_PICKUP_HEALTH
LANG_ENGLISH        "] to pickup health"
LANG_SPANISH        "] para coger el botiquín"


ENDMARKER



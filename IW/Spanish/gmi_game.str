// Note to translators:
// If a sentence is the same in your language then please change it to "#same"
//
// eg:
// LANG_ENGLISH  "HALT"
// LANG_GERMAN   "#same"
//
// (This is so we can tell which strings have been signed-off as ok to be the same words for QA
//  and because we do not store duplicate strings, which will then get exported again next time
//  as being untranslated.)
//
VERSION             "1"
CONFIG              "C:\cod\source_data\string_resources\StringEd.cfg"
FILENOTES           ""

REFERENCE           VEHICLE_DELAY_IGNORE
LANG_ENGLISH        "You must wait before switching positions again."
LANG_SPANISH        "Debes esperar antes de cambiar posiciones de nuevo."

REFERENCE           VEHICLE_UNLINK_BLOCKED
LANG_ENGLISH        "Exit Blocked"
LANG_SPANISH        "Salida bloqueada"

REFERENCE           VEHICLE_HINT
LANG_ENGLISH        "Press [{+activate}] to enter vehicle"
LANG_SPANISH        "Pulsa [USAR] para entrar en el vehículo"

REFERENCE           FLAK_HINT
LANG_ENGLISH        "Press [{+activate}] to use"
LANG_SPANISH        "Pulsa [USAR] para utilizarlo"


ENDMARKER



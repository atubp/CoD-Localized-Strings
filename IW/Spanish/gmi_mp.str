// Note to translators:
// If a sentence is the same in your language then please change it to "#same"
//
// eg:
// LANG_ENGLISH  "HALT"
// LANG_GERMAN   "#same"
//
// (This is so we can tell which strings have been signed-off as ok to be the same words for QA
//  and because we do not store duplicate strings, which will then get exported again next time
//  as being untranslated.)
//
VERSION             "1"
CONFIG              "C:\cod\source_data\string_resources\StringEd.cfg"
FILENOTES           ""

REFERENCE           RESCUE
LANG_ENGLISH        "Rescue Mode Test"
LANG_SPANISH        "Prueba del modo rescate"

REFERENCE           ALLIED_SPAWN_PRIMARY
LANG_ENGLISH        "You will be spawned in the primary deploy location."
LANG_SPANISH        "Aparecerás en el lugar de despliegue primario."

REFERENCE           ALLIED_SPAWN_SECONDARY
LANG_ENGLISH        "You will be spawned in the forward deploy location when it is available."
LANG_SPANISH        "Aparecerás en el lugar de despliegue avanzado cuando esté disponible."


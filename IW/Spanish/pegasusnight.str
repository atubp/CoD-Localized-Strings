// Note to translators:
// If a sentence is the same in your language then please change it to "#same"
//
// eg:
// LANG_ENGLISH  "HALT"
// LANG_GERMAN   "#same"
//
// (This is so we can tell which strings have been signed-off as ok to be the same words for QA
//  and because we do not store duplicate strings, which will then get exported again next time
//  as being untranslated.)
//
VERSION             "1"
CONFIG              "F:\projects\mk-work\bin\StringEd\StringEd.cfg"
FILENOTES           ""

REFERENCE           CLEAR_THE_AREA_OF_ENEMIES
LANG_ENGLISH        "Clear the area of enemies and secure both ends of the bridge."
LANG_SPANISH        "Despejar la zona de enemigos y asegurar ambos lados del puente."

REFERENCE           CAPTURE_THE_BUNKER
LANG_ENGLISH        "Capture the bunker."
LANG_SPANISH        "Capturar el búnker."

REFERENCE           REGROUP_WITH_CAPTAIN
LANG_ENGLISH        "Regroup with Captain Price."
LANG_SPANISH        "Reunirse con el capitán Price."

REFERENCE           FIND_AN_ARMY_ENGINEER
LANG_ENGLISH        "Find an army engineer."
LANG_SPANISH        "Encontrar un ingeniero militar."

REFERENCE           GET_BACK_TO_THE_FLAK
LANG_ENGLISH        "Get back to the flak gun with the army engineer."
LANG_SPANISH        "Volver al arma antiaérea con el ingeniero militar."

REFERENCE           USE_THE_FLAK88_GUN_TO
LANG_ENGLISH        "Use the Flak88 gun to destroy the tank."
LANG_SPANISH        "Usar el Flak88 para destruir el tanque."

REFERENCE           CLEAR_THE_AREA_COUNTER
LANG_ENGLISH        "Clear the area of enemies and secure both ends of the bridge. (%s remaining.)"
LANG_SPANISH        "Despejar la zona de enemigos y asegurar ambos lados del puente. (%s restante.)"


ENDMARKER



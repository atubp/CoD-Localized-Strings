// Note to translators:
// If a sentence is the same in your language then please change it to "#same"
//
// eg:
// LANG_ENGLISH  "HALT"
// LANG_GERMAN   "#same"
//
// (This is so we can tell which strings have been signed-off as ok to be the same words for QA
//  and because we do not store duplicate strings, which will then get exported again next time
//  as being untranslated.)
//
VERSION             "1"
CONFIG              "C:\trees\cod2\bin\StringEd.cfg"
FILENOTES           ""

REFERENCE           OBJ_DOCKS1
LANG_ENGLISH        "Eliminate the Axis naval artillery crews at the docks. [&&1 remaining]"
LANG_SPANISH         "Elimina las dotaciones de artillería naval del Eje del puerto. [&&1 restantes]"

REFERENCE           OBJ_DOCKS2
LANG_ENGLISH        "Eliminate the Axis naval artillery crews at the docks."
LANG_SPANISH         "Elimina las dotaciones de artillería naval del Eje del puerto."

REFERENCE           OBJ_COM
LANG_ENGLISH        "Signal the fleet from the com station radio."
LANG_SPANISH         "Haz señas a la flota desde la radio de la estación de comunicaciones."

REFERENCE           OBJ_HQ
LANG_ENGLISH        "Search the Axis HQ for printed dispatches."
LANG_SPANISH         "Registra el CG del Eje en busca de informes impresos."

REFERENCE           OBJ_PRICE
LANG_ENGLISH        "Regroup at the docks to debrief with Cpt. Price."
LANG_SPANISH         "Reagrúpate en el puerto para informar al capitán Price."

REFERENCE           OBJ_HINT
LANG_ENGLISH        "The location of your current objective is \nmarked on your compass by a gold star."
LANG_SPANISH         "La posición de tu objetivo actual aparece \nseñalada en la brújula mediante una estrella amarilla."


ENDMARKER



// Note to translators:
// If a sentence is the same in your language then please change it to "#same"
//
// eg:
// LANG_ENGLISH  "HALT"
// LANG_GERMAN   "#same"
//
// (This is so we can tell which strings have been signed-off as ok to be the same words for QA
//  and because we do not store duplicate strings, which will then get exported again next time
//  as being untranslated.)
//
VERSION             "1"
CONFIG              "c:\trees\cod2\bin\StringEd_PC.cfg"
FILENOTES           "All game messages made by script should go in this file."

REFERENCE           HINT_OBJECTIVEKEY
LANG_ENGLISH        "Press [&&1] to see your objectives."
LANG_SPANISH         "Pulsa [&&1] para revisar tus objetivos."

REFERENCE           HINT_PRONEKEY
LANG_ENGLISH        "Press [&&1] to go prone"
LANG_SPANISH         "Pulsa [&&1] para echarte cuerpo a tierra."

REFERENCE           HINT_DOUBLETAPPRONEKEY
LANG_ENGLISH        "Double tap [&&1] to go prone"
LANG_SPANISH         "Pulsa dos veces [&&1] para echar cuerpo a tierra."

REFERENCE           HINT_HOLDDOWNPRONEKEY
LANG_ENGLISH        "Hold down [&&1] to go prone"
LANG_SPANISH         "Mantén pulsado [&&1] para echar cuerpo a tierra."

REFERENCE           HINT_ADSKEY
LANG_ENGLISH        "Press [&&1] to aim down the sight"
LANG_SPANISH         "Pulsa [&&1] para apuntar con la mira."

REFERENCE           HINT_HOLDDOWNADSKEY
LANG_ENGLISH        "Hold down [&&1] to aim down the sight"
LANG_SPANISH         "Mantén pulsado [&&1] para apuntar con la mira."

REFERENCE           HINT_STANDFROMPRONEKEY
LANG_ENGLISH        "Press [&&1] to stand up from prone"
LANG_SPANISH         "Pulsa [&&1] para ponerte en pie."

REFERENCE           HINT_DOUBLETAPSTANDKEY
LANG_ENGLISH        "Double tap [&&1] to stand from prone"
LANG_SPANISH         "Pulsa dos veces [&&1] para ponerte en pie."

REFERENCE           HINT_SWITCHTOGRENADE
LANG_ENGLISH        "Press [&&1] to switch to grenades"
LANG_SPANISH         "Pulsa [&&1] para cambiar a granadas."

REFERENCE           HINT_MELEEATTACK
LANG_ENGLISH        "Press [&&1] to do a melee attack"
LANG_SPANISH         "Pulsa [&&1] para realizar un ataque cuerpo a cuerpo."

REFERENCE           HINT_PLANTEXPLOSIVES
LANG_ENGLISH        "Look at the explosives spot and press [&&1] to plant the explosives."
LANG_SPANISH         "Mira al sitio en el que colocar los explosivos y pulsa [&&1] para colocarlos."

REFERENCE           HINT_LEANOUTWINDOW
LANG_ENGLISH        "Press USE [&&1] to lean out of the window"
LANG_SPANISH         "Pulsa USAR [&&1] para asomarte por la ventana."

REFERENCE           HINT_FIRSTOBJECTIVE
LANG_ENGLISH        "Look at your first objective and press USE [&&1] to retrieve"
LANG_SPANISH         "Mira tu primer objetivo y pulsa USAR [&&1] para recuperar."

REFERENCE           HINT_STRAFELEFT
LANG_ENGLISH        "Press your Move Left key [&&1] to move left."
LANG_SPANISH         "Pulsa tu tecla de moverte a la izquierda [&&1] para moverte a la izquierda."

REFERENCE           HINT_STRAFERIGHT
LANG_ENGLISH        "Press your Move Right key [&&1] to move right."
LANG_SPANISH         "Pulsa tu tecla de moverte a la derecha [&&1] para moverte a la derecha."

REFERENCE           HINT_MOVEFORWARD
LANG_ENGLISH        "Press your Move Forward key [&&1] to move forward."
LANG_SPANISH         "Pulsa tu tecla de avanzar [&&1] para avanzar."

REFERENCE           HINT_MOVEBACKWARD
LANG_ENGLISH        "Press your Move Back key [&&1] to move backwards."
LANG_SPANISH         "Pulsa tu tecla de retroceder [&&1] para retroceder."

REFERENCE           HINT_CHECKCURRENTOBJECTIVE
LANG_ENGLISH        "Press [&&1] to check your current objective."
LANG_SPANISH         "Pulsa [&&1] para revisar tu objetivo actual."


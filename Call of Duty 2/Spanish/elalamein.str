// Note to translators:
// If a sentence is the same in your language then please change it to "#same"
//
// eg:
// LANG_ENGLISH  "HALT"
// LANG_GERMAN   "#same"
//
// (This is so we can tell which strings have been signed-off as ok to be the same words for QA
//  and because we do not store duplicate strings, which will then get exported again next time
//  as being untranslated.)
//
VERSION             "1"
CONFIG              "C:\trees\cod2\bin\StringEd.cfg"
FILENOTES           ""

REFERENCE           ASSIST_TANKS_SQUADS_IN
LANG_ENGLISH        "Assist the British armour in breaching the El Alamein line."
LANG_SPANISH         "Ayuda a los blindados británicos a atravesar las líneas de El Alamein."

REFERENCE           FOLLOW_THE_TANKS_ACROSS
LANG_ENGLISH        "Follow the tanks across the valley."
LANG_SPANISH         "Sigue a los tanques por el valle."

REFERENCE           CLEAR_THE_ENEMY_BARRACKS
LANG_ENGLISH        "Clear the enemy barracks."
LANG_SPANISH         "Limpia los cuarteles enemigos."

REFERENCE           MEET_WITH_CAPTAIN_PRICE
LANG_ENGLISH        "Locate the radio within the building."
LANG_SPANISH         "Localiza la radio en el interior del edificio."

REFERENCE           SECURE_THE_VILLAGE_USING
LANG_ENGLISH        "Capture the enemy communications outpost."
LANG_SPANISH         "Toma el puesto de comunicaciones enemigo de avanzada."


ENDMARKER



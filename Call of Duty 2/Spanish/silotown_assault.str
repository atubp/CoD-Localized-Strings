// Note to translators:
// If a sentence is the same in your language then please change it to "#same"
//
// eg:
// LANG_ENGLISH  "HALT"
// LANG_GERMAN   "#same"
//
// (This is so we can tell which strings have been signed-off as ok to be the same words for QA
//  and because we do not store duplicate strings, which will then get exported again next time
//  as being untranslated.)
//
VERSION             "1"
CONFIG              "C:\trees\cod2\bin\StringEd.cfg"
FILENOTES           ""

REFERENCE           REINFORCEMENTS
LANG_ENGLISH        "Reinforcements: "
LANG_SPANISH         "Refuerzos: "

REFERENCE           FRIENDLY_FIRE_WILL_NOT
LANG_ENGLISH        "Friendly fire will not be tolerated!"
LANG_SPANISH         "¡No se permitirá el fuego amigo!"

REFERENCE           SUPPORT_THE_SQUADS_ADVANCE
LANG_ENGLISH        "Support the squad's advance into the town."
LANG_SPANISH         "Apoya el avance del pelotón sobre el pueblo."

REFERENCE           CAPTURE_THE_STONE_FARMHOUSE
LANG_ENGLISH        "Capture the stone farmhouse at the south end of town."
LANG_SPANISH         "Toma la granja de piedra del extremo sur del pueblo."

REFERENCE           CLEAR_THE_BARN_OF_ENEMY
LANG_ENGLISH        "Clear the barn of enemy infantry."
LANG_SPANISH         "Elimina la infantería enemiga del granero."

REFERENCE           SECURE_THE_POST_OFFICE
LANG_ENGLISH        "Secure the post office at the north end of town."
LANG_SPANISH         "Asegura la oficina de correos del extremo norte del pueblo."

REFERENCE           SEIZE_THE_HOUSE_OVERLOOKING
LANG_ENGLISH        "Seize the house overlooking the fork in the road."
LANG_SPANISH         "Toma la casa que domina la bifurcación de la carretera."

REFERENCE           TAKE_CONTROL_OF_THE_SIGNCOVERED
LANG_ENGLISH        "Take control of the sign-covered house at the main intersection."
LANG_SPANISH         "Hazte con el control de la casa cubierta de señales de la intersección principal."

REFERENCE           CLEAR_THE_GERMAN_FIELD
LANG_ENGLISH        "Clear the German field HQ in the manor."
LANG_SPANISH         "Despeja el CG de campaña alemán de la mansión."

REFERENCE           REGROUP_WITH_THE_SQUAD
LANG_ENGLISH        "Regroup with the squad at the intersection."
LANG_SPANISH         "Reúnete con el pelotón en la intersección."

REFERENCE           GET_TO_THE_TOP_OF_THE
LANG_ENGLISH        "Get to the top of the silo with Pvt. Braeburn and Pvt. McCloskey."
LANG_SPANISH         "Sube a lo alto del silo con los soldados Braeburn y McCloskey."

REFERENCE           GET_THE_GERMAN_SNIPER
LANG_ENGLISH        "Get the German sniper rifle in the silo."
LANG_SPANISH         "Coge el rifle de precisión alemán del silo."

REFERENCE           WATCH_OUT_FOR_AN_ENEMY
LANG_ENGLISH        "Watch out for an enemy counterattack."
LANG_SPANISH         "Cuidado con el contraataque enemigo."

REFERENCE           SNIPE_THE_ENEMY_MORTAR
LANG_ENGLISH        "Snipe the enemy mortar teams until reinforcements arrive."
LANG_SPANISH         "Abate a disparos a las dotaciones de morteros enemigos hasta que lleguen los refuerzos."

REFERENCE           HELP_THE_REINFORCEMENTS
LANG_ENGLISH        "Help the reinforcements clear the area of any remaining enemies."
LANG_SPANISH         "Ayuda a los refuerzos a acabar con cualquier enemigo que quede en la zona."

REFERENCE           DEBRIEF_WITH_SGT_RANDALL
LANG_ENGLISH        "Debrief with Sgt. Randall."
LANG_SPANISH         "Informa al sargento Randall."

REFERENCE           ELIMINATE_THE_ENEMY_INFANTRY
LANG_ENGLISH        "Eliminate the enemy infantry occupying the town."
LANG_SPANISH         "Elimina a la infantería enemiga que ocupa el pueblo."


ENDMARKER



// Note to translators:
// If a sentence is the same in your language then please change it to "#same"
//
// eg:
// LANG_ENGLISH  "HALT"
// LANG_GERMAN   "#same"
//
// (This is so we can tell which strings have been signed-off as ok to be the same words for QA
//  and because we do not store duplicate strings, which will then get exported again next time
//  as being untranslated.)
//
VERSION             "1"
CONFIG              "C:\trees\cod2\bin\StringEd.cfg"
FILENOTES           ""

REFERENCE           CRUSADER_TANK
LANG_ENGLISH        "Crusader Tank"
LANG_SPANISH         "Tanque Crusader"

REFERENCE           BUFFALO
LANG_ENGLISH        "Buffalo"
LANG_SPANISH         "#same"

REFERENCE           SHERMAN_TANK
LANG_ENGLISH        "Sherman Tank"
LANG_SPANISH         "Tanque Sherman"

REFERENCE           ARMORED_CAR
LANG_ENGLISH        "Armored Car"
LANG_SPANISH         "Coche blindado"


ENDMARKER


